---
import { Image } from "astro:assets";
import { textos, enIdioma, type Idioma } from "../i18n/textos";
import { entradas, nombreEntrada, fechaLarga, fechaCorta } from "../lib/blog";

interface Props {
  idioma: Idioma;
}

const { idioma } = Astro.props;
const t = textos[idioma];
const lista = await entradas(idioma);
---

<section class="cabeza-pagina">
  <div class="envoltura">
    <h1>{t.blog.titulo}</h1>
    <p>{t.blog.frase}</p>
  </div>
</section>

<section class="envoltura">
  {lista.length === 0 ? (
    <p class="vacio">{t.blog.vacio}</p>
  ) : (
    <ul class="entradas">
      {lista.map((e) => {
        const url = enIdioma(idioma, `/blog/${nombreEntrada(e)}/`);
        const { titulo, nombre } = e.data;
        const [antes, despues] = nombre && titulo.includes(nombre) ? titulo.split(nombre) : [titulo, ""];
        return (
          <li>
            <a href={url} class="miniatura" tabindex="-1" aria-hidden="true">
              {e.data.portada && <Image src={e.data.portada} alt="" width={640} format="webp" />}
            </a>
            <div>
              <h2><a href={url}>{antes}{nombre && titulo.includes(nombre) && <span class="nombre">{nombre}</span>}{despues}</a></h2>
              <p>{e.data.entradilla}</p>
              <p class="meta">
                <span class="etiqueta">{t.blog.etiquetas[e.data.etiqueta]}</span>
                <time datetime={e.data.fecha.toISOString().slice(0, 10)}><span class="fecha-larga">{fechaLarga(e.data.fecha, idioma)}</span><span class="fecha-corta">{fechaCorta(e.data.fecha)}</span></time>
              </p>
            </div>
          </li>
        );
      })}
    </ul>
  )}
</section>

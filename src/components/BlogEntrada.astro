---
import { Image } from "astro:assets";
import { render } from "astro:content";
import { textos, enlaces, enIdioma, type Idioma } from "../i18n/textos";
import { fechaLarga, minutosLectura, type Entrada } from "../lib/blog";

interface Props {
  idioma: Idioma;
  entrada: Entrada;
}

const { idioma, entrada } = Astro.props;
const t = textos[idioma];
const d = entrada.data;
const { Content } = await render(entrada);

// El título se parte alrededor del nombre del modelo para pintarlo sin cortes; la bandera de su lugar subraya el título entero.
const [antes, despues] = d.nombre && d.titulo.includes(d.nombre) ? d.titulo.split(d.nombre) : [d.titulo, ""];
// Los posts de modelos y apps invitan a probarlos; los del laboratorio, a sumarse.
const deLaboratorio = d.etiqueta === "laboratorio";
const franja = d.banderaLugar
  ? `linear-gradient(to right, ${d.banderaLugar
      .map((c, i, l) => `${c} ${((i * 100) / l.length).toFixed(3)}% ${(((i + 1) * 100) / l.length).toFixed(3)}%`)
      .join(", ")})`
  : undefined;
---

<section class="cabeza-entrada">
  <div class="articulo">
    <a class="volver" href={enIdioma(idioma, "/blog/")}>{t.blog.volver}</a>
    <span class="etiqueta">{t.blog.etiquetas[d.etiqueta]}</span>
    <h1 class:list={[{ "con-bandera": franja }]} style={franja ? `--bandera-lugar: ${franja}` : undefined}>
      {antes}
      {d.nombre && d.titulo.includes(d.nombre) && <span class="nombre">{d.nombre}</span>}
      {despues}
    </h1>
    <p class="entradilla">{d.entradilla}</p>
    <div class="meta">
      <span>{d.autor}</span>
      <span><time datetime={d.fecha.toISOString().slice(0, 10)}>{fechaLarga(d.fecha, idioma)}</time></span>
      <span>{minutosLectura(entrada.body)} {t.blog.lectura}</span>
    </div>
  </div>
</section>

{d.portada && (
  <div class="portada-entrada">
    <figure class="figura-portada">
      <Image src={d.portada} alt={d.portadaAlt ?? ""} width={2000} format="webp" />
      {d.portadaPie && <figcaption>{d.portadaPie}</figcaption>}
    </figure>
  </div>
)}

<article class="cuerpo" data-copiar={t.blog.copiar} data-copiado={t.blog.copiado}>
  <div class="articulo">
    <Content />
  </div>
</article>

<section class="cierre">
  <div class="articulo">
    <h2>{deLaboratorio ? t.blog.sumarseTitulo : t.blog.cierreTitulo}</h2>
    <p>{deLaboratorio ? t.blog.sumarseTexto : t.blog.cierreTexto}</p>
    <p><a href={enlaces.discord}>{t.comunidad.discord}</a></p>
    <p><a href={enlaces.discussions}>{t.blog.cierreEnlace}</a></p>
  </div>
</section>

<script>
  // Añade un botón «Copiar» a cada bloque de código del artículo.
  const svg = (trazo: string) =>
    `<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">${trazo}</svg>`;
  const iconoCopiar = svg('<rect x="9" y="9" width="12" height="12" rx="2"/><path d="M5 15H4a1 1 0 0 1-1-1V4a1 1 0 0 1 1-1h10a1 1 0 0 1 1 1v1"/>');
  const iconoCopiado = svg('<path d="M5 12l5 5L20 7"/>');
  const cuerpo = document.querySelector<HTMLElement>(".cuerpo");
  for (const pre of cuerpo?.querySelectorAll("pre") ?? []) {
    const caja = document.createElement("div");
    caja.className = "codigo";
    pre.replaceWith(caja);
    caja.append(pre);
    const boton = document.createElement("button");
    boton.type = "button";
    boton.className = "copiar";
    boton.innerHTML = iconoCopiar;
    boton.title = boton.ariaLabel = cuerpo!.dataset.copiar!;
    boton.addEventListener("click", async () => {
      await navigator.clipboard.writeText(pre.innerText.trimEnd());
      boton.innerHTML = iconoCopiado;
      boton.title = boton.ariaLabel = cuerpo!.dataset.copiado!;
      setTimeout(() => {
        boton.innerHTML = iconoCopiar;
        boton.title = boton.ariaLabel = cuerpo!.dataset.copiar!;
      }, 1500);
    });
    caja.append(boton);
  }
</script>

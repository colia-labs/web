---
import Base from "../layouts/Base.astro";
import { textos } from "../i18n/textos";

// Cloudflare sirve esta página para cualquier dirección que no existe, en los dos idiomas. Por eso lleva los dos.
const { en, es } = textos;
---

<Base idioma="en" ruta="/404/" titulo="404" bilingue={false} rutaOtroIdioma="/es/">
  <div class="tejido"></div>
  <section class="no-existe">
    <div class="envoltura">
      <h1>{en.noExiste.titulo}</h1>
      <p>{en.noExiste.texto} <a href="/">{en.noExiste.enlace}</a></p>
      <h1 lang="es">{es.noExiste.titulo}</h1>
      <p lang="es">{es.noExiste.texto} <a href="/es/">{es.noExiste.enlace}</a></p>
    </div>
  </section>
</Base>
